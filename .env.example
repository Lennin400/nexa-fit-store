PORT=4242
BASE_URL=http://127.0.0.1:4242

# Configuración del Bot (Opcional)
# Los pedidos se guardan en la base de datos local (orders.json) por defecto.
# Si configuras estas variables, los pedidos se notificarán automáticamente al Bot:

# Opción 1: Bot de Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opción 2: Webhook de Bot genérico (Discord / Servidor Bot custom)
BOT_WEBHOOK_URL=
